# Environment Configuration Example
# Copy this file to .env.local and fill in your own values
# .env.local is NOT tracked by git

# WhatsApp Configuration (required for hire-me page)
# Format: Country code + area code + phone number (digits only)
# Example: +55 41 9888-9999 → 554198889999
NUXT_PUBLIC_WHATSAPP_NUMBER=554198889999
NUXT_PUBLIC_CONTACT_EMAIL=myemail@gmail.com
