    "typography": {
        "fontFamily": {
            "serif": "'Merriweather', 'Georgia', serif",
            "sansSerif": "'Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', sans-serif",
            "mono": "'Fira Code', 'Monaco', 'Courier New', monospace"
        },
        "fontSize": {
            "xs": {
                "size": "12px",
                "lineHeight": "16px"
            },
            "sm": {
                "size": "14px",
                "lineHeight": "20px"
            },
            "base": {
                "size": "16px",
                "lineHeight": "24px"
            },
            "lg": {
                "size": "18px",
                "lineHeight": "28px"
            },
            "xl": {
                "size": "20px",
                "lineHeight": "30px"
            },
            "2xl": {
                "size": "24px",
                "lineHeight": "32px"
            },
            "3xl": {
                "size": "30px",
                "lineHeight": "36px"
            },
            "4xl": {
                "size": "36px",
                "lineHeight": "44px"
            },
            "5xl": {
                "size": "48px",
                "lineHeight": "56px"
            }
        },
        "fontWeight": {
            "thin": 100,
            "extralight": 200,
            "light": 300,
            "normal": 400,
            "medium": 500,
            "semibold": 600,
            "bold": 700,
            "extrabold": 800,
            "black": 900
        },
        "headings": {
            "h1": {
                "fontSize": "48px",
                "lineHeight": "56px",
                "fontWeight": 700,
                "family": "sansSerif",
                "marginBottom": "32px"
            },
            "h2": {
                "fontSize": "36px",
                "lineHeight": "44px",
                "fontWeight": 700,
                "family": "sansSerif",
                "marginBottom": "24px"
            },
            "h3": {
                "fontSize": "30px",
                "lineHeight": "36px",
                "fontWeight": 600,
                "family": "sansSerif",
                "marginBottom": "20px"
            },
            "h4": {
                "fontSize": "24px",
                "lineHeight": "32px",
                "fontWeight": 600,
                "family": "sansSerif",
                "marginBottom": "16px"
            },
            "h5": {
                "fontSize": "20px",
                "lineHeight": "30px",
                "fontWeight": 600,
                "family": "sansSerif",
                "marginBottom": "12px"
            },
            "h6": {
                "fontSize": "16px",
                "lineHeight": "24px",
                "fontWeight": 600,
                "family": "sansSerif",
                "marginBottom": "8px"
            }
        },
        "body": {
            "default": {
                "fontSize": "16px",
                "lineHeight": "24px",
                "fontWeight": 400,
                "family": "sansSerif"
            },
            "small": {
                "fontSize": "14px",
                "lineHeight": "20px",
                "fontWeight": 400,
                "family": "sansSerif"
            }
        },
        "code": {
            "fontSize": "14px",
            "lineHeight": "20px",
            "fontWeight": 400,
            "family": "mono",
            "backgroundColor": "background.tertiary",
            "padding": "2px 6px",
            "borderRadius": "4px"
        }
    },
    "spacing": {
        "0": "0px",
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "7": "28px",
        "8": "32px",
        "9": "36px",
        "10": "40px",
        "12": "48px",
        "14": "56px",
        "16": "64px",
        "20": "80px",
        "24": "96px",
        "28": "112px",
        "32": "128px"
    },
    "borderRadius": {
        "none": "0px",
        "sm": "2px",
        "base": "4px",
        "md": "6px",
        "lg": "8px",
        "xl": "12px",
        "2xl": "16px",
        "3xl": "24px",
        "full": "9999px"
    },
    "shadows": {
        "none": "none",
        "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
        "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
        "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
        "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
        "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
    },
    "breakpoints": {
        "mobile": {
            "min": "0px",
            "max": "639px"
        },
        "tablet": {
            "min": "640px",
            "max": "1023px"
        },
        "desktop": {
            "min": "1024px",
            "max": "1535px"
        },
        "wide": {
            "min": "1536px"
        }
    },
    "transitions": {
        "fast": "150ms ease-in-out",
        "normal": "300ms ease-in-out",
        "slow": "500ms ease-in-out"
    },
    "components": {
        "navbar": {
            "height": "64px",
            "padding": "16px 24px",
            "backgroundColor": "background.primary",
            "borderBottom": "1px solid border.light",
            "boxShadow": "sm",
            "zIndex": 100,
            "sticky": true,
            "responsiveHeight": {
                "mobile": "56px",
                "tablet": "64px",
                "desktop": "64px"
            }
        },
        "sidebar": {
            "width": "280px",
            "padding": "24px",
            "backgroundColor": "background.secondary",
            "borderRight": "1px solid border.light",
            "overflowY": "auto",
            "position": "sticky",
            "top": "64px",
            "zIndex": 50,
            "responsiveDisplay": {
                "mobile": "hidden",
                "tablet": "flex",
                "desktop": "flex"
            }
        },
        "postCard": {
            "padding": "20px",
            "backgroundColor": "background.primary",
            "borderRadius": "lg",
            "border": "1px solid border.light",
            "boxShadow": "sm",
            "transition": "normal",
            "hoverState": {
                "boxShadow": "md",
                "transform": "translateY(-2px)"
            },
            "imageHeight": {
                "mobile": "200px",
                "tablet": "240px",
                "desktop": "280px"
            }
        },
        "footer": {
            "backgroundColor": "background.secondary",
            "borderTop": "1px solid border.light",
            "padding": "48px 24px",
            "marginTop": "auto",
            "minHeight": "200px"
        },
        "button": {
            "padding": {
                "sm": "8px 16px",
                "md": "12px 20px",
                "lg": "16px 24px"
            },
            "borderRadius": "lg",
            "fontSize": "base",
            "fontWeight": 600,
            "transition": "fast",
            "cursor": "pointer",
            "border": "none",
            "textDecoration": "none",
            "variants": {
                "primary": {
                    "backgroundColor": "primary.500",
                    "color": "text.white",
                    "hover": {
                        "backgroundColor": "primary.600"
                    }
                },
                "secondary": {
                    "backgroundColor": "neutral.200",
                    "color": "text.primary",
                    "hover": {
                        "backgroundColor": "neutral.300"
                    }
                },
                "outline": {
                    "backgroundColor": "transparent",
                    "border": "2px solid primary.500",
                    "color": "primary.500",
                    "hover": {
                        "backgroundColor": "primary.50"
                    }
                },
                "ghost": {
                    "backgroundColor": "transparent",
                    "color": "primary.500",
                    "hover": {
                        "backgroundColor": "neutral.100"
                    }
                }
            }
        },
        "input": {
            "padding": "12px 16px",
            "fontSize": "base",
            "borderRadius": "lg",
            "border": "1px solid border.light",
            "transition": "fast",
            "focusState": {
                "borderColor": "primary.500",
                "outline": "none",
                "boxShadow": "0 0 0 3px primary.50"
            }
        },
        "card": {
            "padding": "24px",
            "backgroundColor": "background.primary",
            "borderRadius": "xl",
            "border": "1px solid border.light",
            "boxShadow": "base"
        }
    }
}
